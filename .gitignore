node_modules/
.next/
.env.local
.env.production
*.tsbuildinfo

# Production runtime artifacts written by scripts/start-production.sh.
.next-server.pid
logs/

# Internal security notes — keep the threat model out of the public mirror.
SECURITY_FOLLOWUPS.md

